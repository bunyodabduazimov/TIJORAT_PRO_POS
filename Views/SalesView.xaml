<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FFPOS.Controls"
             xmlns:converters="clr-namespace:FFPOS.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="FFPOS.Views.SalesView"
             Background="#F7F8FA"
             FontFamily="Inter, Segoe UI" d:DesignHeight="680.402" d:DesignWidth="1089.262">
    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.09" Color="#0B1220" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToGridLengthConverter x:Key="SidebarWidthConverter" Expanded="250" Collapsed="0" />

        <Style x:Key="ScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#CBD5E1"
                                CornerRadius="5"
                                Margin="3,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Value="{TemplateBinding Value}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="62" />
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B33" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E1261F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TinyIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#102033" />
        </Style>

        <Style x:Key="OrderFooterButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="180" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,8,8,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                    <Setter Property="BorderBrush" Value="#FF2B22" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderTypeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppHeaderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="AppFooterStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppHeaderStyle}" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
            <Grid Margin="18,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="200" />
                    <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="400" />
                    <ColumnDefinition Width="1.1*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource TopIconButtonStyle}">
                        <materialDesign:PackIcon Kind="Menu" Width="28" Height="28" />
                    </Button>
                    <TextBlock Margin="24,0,0,0" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"><Run Text="TIJORAT" Foreground="#111827" /><Run Text="." Foreground="#111827"/><Run Text="PRO" Foreground="#FF332B" /></TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Background="#F2F4F7" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center" Height="46">
                    <UniformGrid Columns="2" VerticalAlignment="Center" Margin="5,0">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Касса" Style="{StaticResource NavButtonStyle}" Background="White" Foreground="#FF2B22">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Margin="0,0,14,0" />
                                <TextBlock Text="Касса" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Заказы" Style="{StaticResource NavButtonStyle}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardListOutline" Width="20" Height="20" Margin="0,0,14,0" />
                                <TextBlock Text="Заказы" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>

                <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ProfileButton" Grid.Column="1" Click="ProfileButton_OnClick" Style="{StaticResource ProfileButtonStyle}">
                        <Border Height="44" CornerRadius="10" BorderBrush="#D9E2EC" BorderThickness="1" Background="#FFFFFF" Padding="10 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountOutline" Width="27" Height="27" Foreground="#23A455" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CashierName}" Foreground="#111827" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" Foreground="#344054" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                    <Popup x:Name="ProfilePopup"
                           PlacementTarget="{Binding ElementName=ProfileButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border
                                Margin="0,8,0,0"
                                Background="White"
                                BorderBrush="#DDE3EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Настройки" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                <Button Command="{Binding LogoutCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Foreground="#FF2B22">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Выйти" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSidebarOpen, Converter={StaticResource SidebarWidthConverter}}" MinWidth="0" MaxWidth="260" />
                <ColumnDefinition Width="*" MinWidth="390" />
                <ColumnDefinition Width="0.60*" MinWidth="400" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E6EBF1" BorderThickness="0,0,1,0" Padding="18,16,4,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,0,16">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:CategoryButton Category="{Binding}"
                                                         IsSelected="{Binding IsSelected}"
                                                         SelectCommand="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    Height="50"
                    Margin="10 10 0 10"
                    VerticalAlignment="Top"
                    BorderThickness="2"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="28" Height="28" Foreground="#344054" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="TopSearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="18"
                                         Foreground="#111827"
                                         Padding="0,10,10,0"/>
                                <TextBlock Text="Поиск товара"
                                           Foreground="#667085"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TopSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Command="{Binding ToggleProductViewCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="46" Height="46">
                        <materialDesign:PackIcon Kind="{Binding ProductViewIcon}" Width="23" Height="23" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="10,65,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,0,26,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="28" Height="28" Foreground="#344054" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="19"
                                         Foreground="#111827"
                                         Padding="0,20,12,0" />
                                <TextBlock Text="Поиск товара по названию или штрихкоду"
                                           Foreground="#667085"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="{Binding ProductViewIcon}" Command="{Binding ToggleProductViewCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="96" Height="68" FontSize="24" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsCardView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Width" Value="132" />
                                <Setter Property="Height" Value="124" />
                                <Setter Property="Margin" Value="0,0,9,9" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ProductCard Product="{Binding}"
                                                      AddCommand="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0,0,0,0"
                        Background="White"
                        BorderBrush="#DEE4EC"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                            <Grid Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Фото" FontSize="13" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Товар" FontSize="13" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Остаток" FontSize="13" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Цена" FontSize="13" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                FocusVisualStyle="{x:Null}"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder" Background="White" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="14,0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF7F6" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF0EF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Height="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding ImagePath}" Width="42" Height="38" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="#111827" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Арт: " FontSize="11" Foreground="#98A2B3" />
                                                        <TextBlock Text="{Binding Sku, TargetNullValue=-}" FontSize="11" Foreground="#667085" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                        <TextBlock Text="  ШК: " FontSize="11" Foreground="#98A2B3" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Barcode, TargetNullValue=-}" FontSize="11" Foreground="#667085" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat={}{0:0.##}}" FontSize="13" FontWeight="Medium" Foreground="#475467" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat={}{0:0} c}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
                                                <Border Grid.Column="4" Width="42" Height="34" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock FontSize="15" Foreground="#102033" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Text" Value="+" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSelectedQuantity}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding SelectedQuantity}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsProductPagerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding PreviousProductPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="32" Height="26">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding ProductPageText}" FontSize="13" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="12,0" />
                    <Button Grid.Column="2" Command="{Binding NextProductPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="32" Height="26">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Column="2" Margin="10">
                <Border Grid.Row="1" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="32" />
                            <RowDefinition />
                            <RowDefinition Height="75" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="16,0,16,0">
                            <Grid>
                                <TextBlock Text="{Binding CurrentOrder.DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,184,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding AddNoteCommand}" Style="{StaticResource TinyIconButtonStyle}">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="22" Height="22" />
                                    </Button>
                                    <Button Command="{Binding ShowCustomerCommand}" Style="{StaticResource TinyIconButtonStyle}" Margin="6,0,0,0">
                                        <materialDesign:PackIcon Kind="AccountPlusOutline" Width="22" Height="22" />
                                    </Button>
                                    <Button Command="{Binding ShowReceiptCommand}" Style="{StaticResource TinyIconButtonStyle}" Margin="6,0,0,0">
                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="22" Height="22" />
                                    </Button>
                                    <Button x:Name="OrderActionsButton" Click="OrderActionsButton_OnClick" Style="{StaticResource TinyIconButtonStyle}" Margin="6,0,0,0">
                                        <materialDesign:PackIcon Kind="DotsVertical" Width="22" Height="22" />
                                    </Button>
                                    <Popup x:Name="OrderActionsPopup"
                                           PlacementTarget="{Binding ElementName=OrderActionsButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Width="230"
                                                Margin="0,8,0,0"
                                                Background="White"
                                                BorderBrush="#DDE3EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8"
                                                Effect="{StaticResource SoftShadow}">
                                            <StackPanel>
                                                <Button Command="{Binding AddNoteCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Примечание" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding HoldOrderCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="PauseCircleOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Отложить чек" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                                <Button Command="{Binding ClearOrderCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Foreground="#FF2B22">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Очистить чек" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Фото" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Товар" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Кол-во" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Цена" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Сумма" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="ReceiptItemsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,0" Margin="0,0,0,85" Grid.RowSpan="2">
                            <ItemsControl x:Name="ReceiptItemsControl" ItemsSource="{Binding CurrentOrder.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:OrderItemRow Item="{Binding}"
                                                               IncreaseCommand="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               DecreaseCommand="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               RemoveCommand="{Binding DataContext.RemoveOrderItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" VerticalAlignment="Top" Margin="16,0">
                            <Button Command="{Binding PayCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="64" Margin="0,0,0,0" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Оплатить" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentOrder.Total, StringFormat={}{0:0} c}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,16,0" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppFooterStyle}">
            <Grid Margin="18,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Чеки" FontSize="16" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="1" Height="34" Background="#E6EBF1" />
                    <Border Grid.Column="2" Width="34" Height="34" CornerRadius="17" Background="#F2F4F7">
                        <TextBlock Text="{Binding OpenOrders.Count}" Foreground="#111827" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OpenOrders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource OrderFooterButtonStyle}">
                                    <Grid Width="154">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Width="20" Height="20" CornerRadius="5" Background="#FB970E" VerticalAlignment="Center">
                                            <TextBlock Text="Ⅱ" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:0} c}" FontSize="14" FontWeight="SemiBold" Foreground="#475467" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2" Command="{Binding CreateNewOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="210" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="23" Foreground="#344054" Margin="0,-4,12,0" />
                        <TextBlock Text="Новый чек" FontSize="16" Foreground="#344054" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
