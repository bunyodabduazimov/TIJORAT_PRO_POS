<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FFPOS.Controls"
             xmlns:converters="clr-namespace:FFPOS.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="FFPOS.Views.SalesView"
             x:Name="Root"
             Background="#F7F8FA"
             FontFamily="Inter, Segoe UI" d:DesignHeight="680.402" d:DesignWidth="1089.262">
    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.09" Color="#0B1220" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
        <converters:BoolToGridLengthConverter x:Key="SidebarWidthConverter" Expanded="250" Collapsed="0" />
        <converters:BoolToGridLengthConverter x:Key="FooterHeightConverter" Expanded="60" Collapsed="0" />
        <converters:BoolToGridLengthConverter x:Key="StockColumnWidthConverter" Expanded="90" Collapsed="0" />
        <converters:SortDirectionToIconConverter x:Key="SortDirectionToIconConverter" />
        <controls:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <Style x:Key="ScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#CBD5E1"
                                CornerRadius="5"
                                Margin="3,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Value="{TemplateBinding Value}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="62" />
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B33" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E1261F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TinyIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#102033" />
        </Style>

        <Style x:Key="OrderFooterButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="204" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,8,8,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                    <Setter Property="BorderBrush" Value="#FF2B22" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaymentGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E5EBF2" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <materialDesign:PackIcon x:Name="SortIcon"
                                                         Grid.Column="1"
                                                         Kind="{Binding SortDirection, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SortDirectionToIconConverter}}"
                                                         Width="14"
                                                         Height="14"
                                                         Foreground="#98A2B3"
                                                         VerticalAlignment="Center"
                                                         Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="{x:Null}">
                                <Setter TargetName="SortIcon" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortIcon" Property="Foreground" Value="#111827" />
                                <Setter TargetName="SortIcon" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortIcon" Property="Foreground" Value="#111827" />
                                <Setter TargetName="SortIcon" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                        </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReceiptItemsGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E5EBF2" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentGridCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <Style x:Key="PaymentGridRightCellTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PaymentGridCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="PaymentGridCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderBrush" Value="#EEF2F6" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaymentGridRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EEF2F6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaymentDataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource PaymentGridHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource PaymentGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource PaymentGridRowStyle}" />
        </Style>

        <Style x:Key="OrderItemsGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource PaymentGridRowStyle}">
            <Setter Property="Height" Value="58" />
        </Style>

        <Style x:Key="OrderItemsGridCellTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PaymentGridCellTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="10,0" />
        </Style>

        <Style x:Key="OrderItemsGridRightCellTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource OrderItemsGridCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="OrderItemsGridCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PaymentGridCellStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="OrderItemsGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource PaymentDataGridStyle}">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ReceiptItemsGridHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource OrderItemsGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource OrderItemsGridRowStyle}" />
            <Setter Property="CanUserSortColumns" Value="False" />
        </Style>

        <Style x:Key="ReceiptItemsGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource PaymentGridRowStyle}">
            <Setter Property="Height" Value="46" />
        </Style>

        <Style x:Key="ReceiptItemsGridCellTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PaymentGridCellTextStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ReceiptItemsGridRightCellTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ReceiptItemsGridCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="InlineValueTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#FFB8B3" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReceiptItemsGridCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource PaymentGridCellStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="ReceiptItemsGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource PaymentDataGridStyle}">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ReceiptItemsGridHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource ReceiptItemsGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource ReceiptItemsGridRowStyle}" />
            <Setter Property="CanUserSortColumns" Value="False" />
        </Style>

        <Style x:Key="ReceiptItemsGridClickableCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource ReceiptItemsGridCellStyle}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ReceiptItemCell_OnPreviewMouseLeftButtonUp" />
        </Style>

        <Style x:Key="ReceiptItemsGridQuantityCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource ReceiptItemsGridClickableCellStyle}">
            <Setter Property="Tag" Value="Quantity" />
        </Style>

        <Style x:Key="ReceiptItemsGridPriceCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource ReceiptItemsGridClickableCellStyle}">
            <Setter Property="Tag" Value="Price" />
        </Style>

        <Style x:Key="ReceiptItemsGridTotalCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource ReceiptItemsGridClickableCellStyle}">
            <Setter Property="Tag" Value="Total" />
        </Style>

        <Style x:Key="InlineTextButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderTypeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppHeaderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="AppFooterStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{Binding IsCashierSection, Converter={StaticResource FooterHeightConverter}}" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource AppHeaderStyle}" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
            <Grid Margin="18,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="200" />
                    <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="400" />
                    <ColumnDefinition Width="1.1*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource TopIconButtonStyle}">
                        <materialDesign:PackIcon Kind="Menu" Width="28" Height="28" />
                    </Button>
                    <TextBlock Margin="24,0,0,0" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"><Run Text="TIJORAT" Foreground="#111827" /><Run Text="." Foreground="#111827"/><Run Text="PRO" Foreground="#FF332B" /></TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Background="#F2F4F7" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center" Height="46">
                    <UniformGrid Columns="3" VerticalAlignment="Center" Margin="5,0">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Касса">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashierSection}" Value="True">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="#FF2B22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Margin="0,0,14,0" />
                                <TextBlock Text="Касса" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Заказы" Margin="8,0,0,0" Visibility="{Binding CanShowOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOrdersSection}" Value="True">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="#FF2B22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardListOutline" Width="20" Height="20" Margin="0,0,14,0" />
                                <TextBlock Text="Заказы" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Платежи" Margin="8,0,0,0" Visibility="{Binding CanShowPayments, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentsSection}" Value="True">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="#FF2B22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Margin="0,0,14,0" />
                                <TextBlock Text="Платежи" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>

                <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ProfileButton" Grid.Column="1" Click="ProfileButton_OnClick" Style="{StaticResource ProfileButtonStyle}">
                        <Border Height="44" CornerRadius="10" BorderBrush="#D9E2EC" BorderThickness="1" Background="#FFFFFF" Padding="10 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountOutline" Width="27" Height="27" Foreground="#111827" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CashierName}" Foreground="#111827" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" Foreground="#344054" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                    <Popup x:Name="ProfilePopup"
                           PlacementTarget="{Binding ElementName=ProfileButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border
                                Margin="0,8,0,0"
                                Background="White"
                                BorderBrush="#DDE3EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsShiftEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Background="{Binding ShiftStatusBackground}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ShiftStatusText}" FontSize="14" FontWeight="Bold" Foreground="{Binding ShiftStatusBrush}" />
                                            <TextBlock Text="{Binding ShiftStatusHint}" FontSize="12" Foreground="#667085" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ShiftRemainingText}" FontSize="12" Foreground="#344054" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Button Command="{Binding OpenShiftCommand}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ProfileMenuButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOpenShift}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Kind="LockOpenOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                            <TextBlock Text="Открыть смену" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CloseShiftCommand}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ProfileMenuButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOpenShift}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Kind="LockOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                            <TextBlock Text="Закрыть смену" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                </StackPanel>
                                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Настройки" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                <Button Command="{Binding LogoutCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Foreground="#FF2B22">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Выйти" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsCashierSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSidebarOpen, Converter={StaticResource SidebarWidthConverter}}" MinWidth="0" MaxWidth="260" />
                <ColumnDefinition Width="*" MinWidth="390" />
                <ColumnDefinition Width="0.60*" MinWidth="400" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E6EBF1" BorderThickness="0,0,1,0" Padding="18,16,8,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,0,16">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,8,6" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:CategoryButton Category="{Binding}"
                                                         IsSelected="{Binding IsSelected}"
                                                         SelectCommand="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    Height="50"
                    Margin="10 10 0 10"
                    VerticalAlignment="Top"
                    BorderThickness="2"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="28" Height="28" Foreground="#344054" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="TopSearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="19"
                                         Foreground="#111827"
                                         Padding="0,10,10,0"/>
                                <TextBlock Text="Поиск товара"
                                           Foreground="#667085"
                                           FontSize="19"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TopSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Command="{Binding ToggleProductViewCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="46" Height="46">
                        <materialDesign:PackIcon Kind="{Binding ProductViewIcon}" Width="23" Height="23" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="10,65,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,0,26,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="28" Height="28" Foreground="#344054" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="20"
                                         Foreground="#111827"
                                         Padding="0,20,12,0" />
                                <TextBlock Text="Поиск товара по названию или штрихкоду"
                                           Foreground="#667085"
                                           FontSize="21"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="{Binding ProductViewIcon}" Command="{Binding ToggleProductViewCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="96" Height="68" FontSize="25" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsCardView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Width" Value="132" />
                                <Setter Property="Height" Value="124" />
                                <Setter Property="Margin" Value="0,0,9,9" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ProductCard Product="{Binding}"
                                                      AddCommand="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0,0,0,0"
                        Background="White"
                        BorderBrush="#DEE4EC"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                            <Grid Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{Binding ShowStockQuantity, Converter={StaticResource StockColumnWidthConverter}}" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Фото" FontSize="14" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Товар" FontSize="14" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Остаток" FontSize="14" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" Visibility="{Binding ShowStockQuantity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Grid.Column="3" Text="Цена" FontSize="14" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                FocusVisualStyle="{x:Null}"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder" Background="White" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="14,0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF7F6" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF0EF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Height="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{Binding DataContext.ShowStockQuantity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource StockColumnWidthConverter}}" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding ImagePath}" Width="42" Height="38" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" Foreground="#111827" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Арт: " FontSize="12" Foreground="#98A2B3" />
                                                        <TextBlock Text="{Binding Sku, TargetNullValue=-}" FontSize="12" Foreground="#667085" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                        <TextBlock Text="  ШК: " FontSize="12" Foreground="#98A2B3" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Barcode, TargetNullValue=-}" FontSize="12" Foreground="#667085" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat={}{0:0.##}}" FontSize="14" FontWeight="Medium" Foreground="#475467" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowStockQuantity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat={}{0:0} c}" FontSize="15" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
                                                <Border Grid.Column="4" Width="42" Height="34" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock FontSize="16" Foreground="#102033" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Text" Value="+" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSelectedQuantity}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding SelectedQuantity}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsProductPagerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding PreviousProductPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="32" Height="26">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding ProductPageText}" FontSize="14" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="12,0" />
                    <Button Grid.Column="2" Command="{Binding NextProductPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="32" Height="26">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Column="2" Margin="10">
                <Border Grid.Row="1" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="32" />
                            <RowDefinition />
                            <RowDefinition Height="75" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="16,0,16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentOrder.DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <Border Grid.Column="1" Background="#F2F4F7" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="8" Height="38" Width="190" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <UniformGrid Columns="2" Margin="3">
                                        <Button Command="{Binding SelectSaleTypeCommand}" CommandParameter="sale" Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="#344054" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="10,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSaleSelected}" Value="True">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="Foreground" Value="#FF2B22" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Продажа" FontSize="13" FontWeight="Bold" />
                                        </Button>
                                        <Button Command="{Binding SelectSaleTypeCommand}" CommandParameter="sale_return" Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Visibility="{Binding CanReturnSale, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="#344054" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="10,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSaleReturnSelected}" Value="True">
                                                            <Setter Property="Background" Value="White" />
                                                            <Setter Property="Foreground" Value="#FF2B22" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Возврат" FontSize="13" FontWeight="Bold" />
                                        </Button>
                                    </UniformGrid>
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding ShowReceiptCommand}" Style="{StaticResource TinyIconButtonStyle}" Margin="0,0,0,0" ToolTip="Печать чека">
                                        <materialDesign:PackIcon Kind="Printer" Width="22" Height="22" />
                                    </Button>
                                    <Button x:Name="OrderActionsButton" Click="OrderActionsButton_OnClick" Style="{StaticResource TinyIconButtonStyle}" Margin="6,0,0,0" ToolTip="Действия">
                                        <materialDesign:PackIcon Kind="DotsVertical" Width="22" Height="22" />
                                    </Button>
                                    <Popup x:Name="OrderActionsPopup"
                                           PlacementTarget="{Binding ElementName=OrderActionsButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Width="230"
                                                Margin="0,8,0,0"
                                                Background="White"
                                                BorderBrush="#DDE3EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8"
                                                Effect="{StaticResource SoftShadow}">
                                            <StackPanel>
                                                <Button Command="{Binding HoldOrderCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="PauseCircleOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Отложить чек" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                                <Button Command="{Binding ClearOrderCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Foreground="#FF2B22">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Очистить чек" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="ReceiptItemsGrid"
                                  Grid.Row="1"
                                  Grid.RowSpan="2"
                                  ItemsSource="{Binding CurrentOrder.Items}"
                                  Style="{StaticResource ReceiptItemsGridStyle}"
                                  Margin="10,0,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Фото" Width="56" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding Product.ImagePath}"
                                                       Width="34"
                                                       Height="30"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Товар" Width="2.2*" MinWidth="160" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Product.Name}"
                                                       Style="{StaticResource ReceiptItemsGridCellTextStyle}"
                                                       FontWeight="Normal"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Кол-во" Width="86" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellStyle>
                                        <StaticResource ResourceKey="ReceiptItemsGridQuantityCellStyle" />
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, Mode=OneWay}"
                                                     Tag="Quantity"
                                                     Style="{StaticResource InlineValueTextBoxStyle}"
                                                     IsReadOnly="{Binding DataContext.IsInlineQuantityReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     LostFocus="CurrentOrderInlineValue_LostFocus"
                                                     PreviewTextInput="InlineValue_PreviewTextInput" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Цена" Width="92" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellStyle>
                                        <StaticResource ResourceKey="ReceiptItemsGridPriceCellStyle" />
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Price, StringFormat={}{0:0.##}, Mode=OneWay}"
                                                     Tag="Price"
                                                     Style="{StaticResource InlineValueTextBoxStyle}"
                                                     IsReadOnly="{Binding DataContext.IsInlinePriceReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     LostFocus="CurrentOrderInlineValue_LostFocus"
                                                     PreviewTextInput="InlineValue_PreviewTextInput" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Сумма" Width="92" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellStyle>
                                        <StaticResource ResourceKey="ReceiptItemsGridTotalCellStyle" />
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Total, StringFormat={}{0:0.##}, Mode=OneWay}"
                                                     Tag="Total"
                                                     Style="{StaticResource InlineValueTextBoxStyle}"
                                                     IsReadOnly="{Binding DataContext.IsInlinePriceReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     LostFocus="CurrentOrderInlineValue_LostFocus"
                                                     PreviewTextInput="InlineValue_PreviewTextInput" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3" VerticalAlignment="Top" Margin="16,0">
                            <Button Command="{Binding PayCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="64" Margin="0,0,0,0" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SaleActionText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentOrder.Total, StringFormat={}{0:0} c}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,16,0" Visibility="{Binding ShowTotals, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsOrdersSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620" />
                <ColumnDefinition Width="0.52*" MinWidth="420" MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <Border Background="#F8FAFC" BorderBrush="#E6EBF1" BorderThickness="0,0,1,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Height="40" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="OrderSearchBox"
                                             Text="{Binding OrderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="16"
                                             Foreground="#111827"
                                             Padding="0,8,10,0" />
                                    <TextBlock Text="Поиск заказа, клиента, суммы"
                                               Foreground="#98A2B3"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=OrderSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="2"
                                        Command="{Binding ClearOrderSearchCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FocusVisualStyle="{x:Null}"
                                        Cursor="Hand"
                                        ToolTip="Очистить">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=OrderSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Foreground="#667085" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding SetOrderFilterCommand}" CommandParameter="open" Style="{StaticResource SecondaryButtonStyle}" Width="104" Height="40" Margin="8,0,0,0">
                                <TextBlock Text="Открытые" />
                            </Button>
                            <Button Command="{Binding SetOrderFilterCommand}" CommandParameter="paid" Style="{StaticResource SecondaryButtonStyle}" Width="112" Height="40" Margin="8,0,0,0">
                                <TextBlock Text="Оплачено" />
                            </Button>
                            <Button Command="{Binding SetOrderFilterCommand}" CommandParameter="today" Style="{StaticResource SecondaryButtonStyle}" Width="92" Height="40" Margin="8,0,0,0">
                                <TextBlock Text="Сегодня" />
                            </Button>
                            <Button Command="{Binding SetOrderFilterCommand}" CommandParameter="all" Style="{StaticResource SecondaryButtonStyle}" Width="72" Height="40" Margin="8,0,0,0">
                                <TextBlock Text="Все" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Orders}"
                                      SelectedItem="{Binding SelectedOrderListItem, Mode=TwoWay}"
                                      Style="{StaticResource PaymentDataGridStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Чек" Binding="{Binding NumberText}" SortMemberPath="Number" Width="115" MinWidth="104" ElementStyle="{StaticResource PaymentGridCellTextStyle}" />
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" SortMemberPath="Date" Width="145" MinWidth="136" ElementStyle="{StaticResource PaymentGridCellTextStyle}" />
                                    <DataGridTextColumn Header="Тип" Binding="{Binding SaleTypeText}" SortMemberPath="SaleTypeText" Width="95" MinWidth="90" ElementStyle="{StaticResource PaymentGridCellTextStyle}" />
                                    <DataGridTemplateColumn Header="Клиент" SortMemberPath="CustomerName" Width="2*" MinWidth="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#667085" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Статус" SortMemberPath="StatusText" Width="96" MinWidth="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Height="24" CornerRadius="12" Background="{Binding StatusBackground}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="10,0" Margin="12,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Товаров" Binding="{Binding ItemsCount}" SortMemberPath="ItemsCount" Width="88" MinWidth="82" ElementStyle="{StaticResource PaymentGridRightCellTextStyle}" />
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalText}" SortMemberPath="Total" Width="120" MinWidth="110" ElementStyle="{StaticResource PaymentGridRightCellTextStyle}" Visibility="{Binding Data.ShowTotals, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <DataGridTextColumn Header="Синх." Binding="{Binding SyncText}" SortMemberPath="SyncText" Width="98" MinWidth="90" ElementStyle="{StaticResource PaymentGridRightCellTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OrdersSummary}" FontSize="14" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding PreviousOrderPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="36" Height="30">
                                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding OrderPageText}" FontSize="14" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="12,0" />
                                        <Button Grid.Column="2" Command="{Binding NextOrderPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="36" Height="30">
                                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="12,12,12,12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="174" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="{Binding SelectedOrderListItem.NumberText, TargetNullValue=Выберите заказ}" FontSize="21" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding OpenSelectedOrderCommand}" Style="{StaticResource TinyIconButtonStyle}" ToolTip="Открыть в кассе">
                                <materialDesign:PackIcon Kind="OpenInNew" Width="21" Height="21" />
                            </Button>
                            <Button Command="{Binding PrintSelectedOrderCommand}" Style="{StaticResource TinyIconButtonStyle}" Margin="6,0,0,0" ToolTip="Печать">
                                <materialDesign:PackIcon Kind="Printer" Width="21" Height="21" />
                            </Button>
                            <Button Command="{Binding DeleteSelectedOrderCommand}" Style="{StaticResource TinyIconButtonStyle}" Margin="6,0,0,0" ToolTip="Удалить">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="21" Height="21" Foreground="#FF2B22" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Клиент" FontSize="13" FontWeight="SemiBold" Foreground="#667085" />
                                <TextBlock Text="{Binding SelectedOrderListItem.CustomerName}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Тип" FontSize="13" FontWeight="SemiBold" Foreground="#667085" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedOrderListItem.OrderType}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Дата" FontSize="13" FontWeight="SemiBold" Foreground="#667085" />
                                <TextBlock Text="{Binding SelectedOrderListItem.DateText}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" />
                                <TextBlock Text="Примечание" FontSize="13" FontWeight="SemiBold" Foreground="#667085" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedOrderListItem.Note, TargetNullValue=-}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="#E8EDF3" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding SelectedOrderListItem.Order.Items}"
                                      Style="{StaticResource OrderItemsGridStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Фото" Width="52" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding Product.ImagePath}"
                                                           Width="28"
                                                           Height="28"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Товар" Width="2.2*" MinWidth="150" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Product.Name}"
                                                           Style="{StaticResource OrderItemsGridCellTextStyle}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Кол-во" Width="74" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, Mode=OneWay}"
                                                     Tag="Quantity"
                                                     Style="{StaticResource InlineValueTextBoxStyle}"
                                                     IsReadOnly="{Binding DataContext.IsInlineQuantityReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     LostFocus="SelectedOrderInlineValue_LostFocus"
                                                     PreviewMouseLeftButtonUp="SelectedOrderInlineValue_PreviewMouseLeftButtonUp"
                                                     PreviewTextInput="InlineValue_PreviewTextInput" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Цена" Width="82" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Price, StringFormat={}{0:0.##}, Mode=OneWay}"
                                                     Tag="Price"
                                                     Style="{StaticResource InlineValueTextBoxStyle}"
                                                     IsReadOnly="{Binding DataContext.IsInlinePriceReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     LostFocus="SelectedOrderInlineValue_LostFocus"
                                                     PreviewMouseLeftButtonUp="SelectedOrderInlineValue_PreviewMouseLeftButtonUp"
                                                     PreviewTextInput="InlineValue_PreviewTextInput" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Сумма" Width="92" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Total, StringFormat={}{0:0.##}, Mode=OneWay}"
                                                     Tag="Total"
                                                     Style="{StaticResource InlineValueTextBoxStyle}"
                                                     FontWeight="Bold"
                                                     IsReadOnly="{Binding DataContext.IsInlinePriceReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     LostFocus="SelectedOrderInlineValue_LostFocus"
                                                     PreviewMouseLeftButtonUp="SelectedOrderInlineValue_PreviewMouseLeftButtonUp"
                                                     PreviewTextInput="InlineValue_PreviewTextInput" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedOrderListItem.Subtotal, StringFormat=Итого: {0:0.00} c}" FontSize="16" FontWeight="SemiBold" Foreground="#344054" HorizontalAlignment="Right" Visibility="{Binding ShowTotals, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Row="1" Text="{Binding SelectedOrderListItem.Discount, StringFormat=Скидка: {0:0.00} c}" FontSize="16" FontWeight="SemiBold" Foreground="#344054" HorizontalAlignment="Right" Visibility="{Binding ShowDiscountTotals, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Row="2" Text="{Binding SelectedOrderListItem.Total, StringFormat=К оплате: {0:0.00} c}" FontSize="21" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Right" Visibility="{Binding ShowTotals, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding OpenSelectedOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="54" Margin="0,0,6,0">
                                <TextBlock Text="Открыть" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Button>
                            <Button Grid.Column="1" Command="{Binding PaySelectedOrderCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="54" Margin="6,0,0,0">
                                <TextBlock Text="Оплатить" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsPaymentsSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#F8FAFC" Padding="18,18,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Height="40" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PaymentSearchBox"
                                             Text="{Binding PaymentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="16"
                                             Foreground="#111827"
                                             Padding="0,8,10,0" />
                                    <Button Grid.Column="1"
                                            Command="{Binding ClearPaymentSearchCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FocusVisualStyle="{x:Null}"
                                            Cursor="Hand"
                                            ToolTip="Очистить">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PaymentSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Foreground="#667085" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Button>
                                    <TextBlock Text="Поиск платежа"
                                               Foreground="#98A2B3"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PaymentSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="PaymentActionsButton" Click="PaymentActionsButton_OnClick" Style="{StaticResource SecondaryButtonStyle}" Width="150" Height="40" ToolTip="Создать" Visibility="{Binding CanAddAnyPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Создать" VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="PaymentActionsPopup"
                                   PlacementTarget="{Binding ElementName=PaymentActionsButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Width="240"
                                        Margin="0,8,0,0"
                                        Background="White"
                                        BorderBrush="#DDE3EB"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8"
                                        Effect="{StaticResource SoftShadow}">
                                    <StackPanel>
                                        <Button Command="{Binding AddCustomerInPaymentCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Visibility="{Binding CanAddCustomerInPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="AccountArrowLeftOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                <TextBlock Text="Платеж от контрагента" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AddCustomerOutPaymentCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Visibility="{Binding CanAddCustomerOutPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="AccountArrowRightOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                <TextBlock Text="Платеж контрагенту" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                        <Button Command="{Binding AddCashInPaymentCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Visibility="{Binding CanAddCashInPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="CashPlus" Width="20" Height="20" Margin="0,0,12,0" />
                                                <TextBlock Text="Приходный ордер" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding AddCashOutPaymentCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Visibility="{Binding CanAddCashOutPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <materialDesign:PackIcon Kind="CashMinus" Width="20" Height="20" Margin="0,0,12,0" />
                                                <TextBlock Text="Расходный ордер" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Payments}"
                                      SelectedItem="{Binding SelectedPaymentListItem, Mode=TwoWay}"
                                      Style="{StaticResource PaymentDataGridStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" SortMemberPath="DateText" Width="150" MinWidth="142" ElementStyle="{StaticResource PaymentGridCellTextStyle}" />
                                    <DataGridTemplateColumn Header="Операция" SortMemberPath="OperationText" Width="2.1*" MinWidth="260">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="{Binding OperationText}" FontSize="14" FontWeight="SemiBold" Foreground="#111827" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ArticleName}" FontSize="12" Foreground="#667085" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Контрагент" Binding="{Binding CustomerName}" SortMemberPath="CustomerName" Width="1.25*" MinWidth="190" ElementStyle="{StaticResource PaymentGridCellTextStyle}" />
                                    <DataGridTextColumn Header="Касса" Binding="{Binding CashName}" SortMemberPath="CashName" Width="1*" MinWidth="150" ElementStyle="{StaticResource PaymentGridCellTextStyle}" />
                                    <DataGridTemplateColumn Header="Тип" SortMemberPath="DirectionText" Width="92" MinWidth="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Height="24" CornerRadius="12" Background="{Binding DirectionBackground}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="10,0" Margin="12,0">
                                                    <TextBlock Text="{Binding DirectionText}" FontSize="12" FontWeight="Bold" Foreground="{Binding DirectionBrush}" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding AmountText}" SortMemberPath="Amount" Width="125" MinWidth="116" ElementStyle="{StaticResource PaymentGridRightCellTextStyle}" Visibility="{Binding Data.ShowTotals, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <DataGridTextColumn Header="Синх." Binding="{Binding SyncText}" SortMemberPath="SyncText" Width="100" MinWidth="92" ElementStyle="{StaticResource PaymentGridRightCellTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PaymentsSummary}" FontSize="14" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding PreviousPaymentPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="36" Height="30">
                                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding PaymentPageText}" FontSize="14" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="12,0" />
                                        <Button Grid.Column="2" Command="{Binding NextPaymentPageCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="36" Height="30">
                                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
                                        </Button>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding ShowTotals, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Приход:" FontSize="14" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding PaymentIncomeTotalText}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <TextBlock Text="Расход:" FontSize="14" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding PaymentExpenseTotalText}" FontSize="14" FontWeight="Bold" Foreground="#FF2B22" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppFooterStyle}" Visibility="{Binding IsCashierSection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="18,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Чеки" FontSize="17" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="1" Height="34" Background="#E6EBF1" />
                    <Border Grid.Column="2" Width="34" Height="34" CornerRadius="17" Background="#F2F4F7">
                        <TextBlock Text="{Binding OpenOrders.Count}" Foreground="#111827" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OpenOrders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource OrderFooterButtonStyle}">
                                    <Grid Width="176">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <Border Grid.Column="1" Width="18" Height="18" CornerRadius="5" Background="#FB970E" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="?" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:0} c}" FontSize="15" FontWeight="SemiBold" Foreground="#475467" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowTotals, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2" Command="{Binding CreateNewOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="180" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="24" Foreground="#344054" Margin="0,-4,12,0" />
                        <TextBlock Text="Новый чек" FontSize="17" Foreground="#344054" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>


