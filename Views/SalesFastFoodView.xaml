<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FFPOS.Controls"
             xmlns:converters="clr-namespace:FFPOS.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="FFPOS.Views.SalesFastFoodView"
             Background="#F7F8FA"
             FontFamily="Inter, Segoe UI">
    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.09" Color="#0B1220" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToGridLengthConverter x:Key="SidebarWidthConverter" Expanded="340" Collapsed="0" />

        <Style x:Key="ScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#CBD5E1"
                                CornerRadius="5"
                                Margin="3,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Value="{TemplateBinding Value}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#111C2B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#172438" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#22324A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="50" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#172438" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#22324A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="76" />
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B33" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E1261F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TinyIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#102033" />
        </Style>

        <Style x:Key="OrderFooterButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="62" />
            <Setter Property="Width" Value="240" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,10,12,10" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                    <Setter Property="BorderBrush" Value="#FF2B22" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileMenuButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderTypeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="55" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="85" />
        </Grid.RowDefinitions>

        <Border Background="#07101B" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
            <Grid Margin="30,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="530" />
                    <ColumnDefinition Width="700" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource TopIconButtonStyle}">
                        <materialDesign:PackIcon Kind="Menu" Width="28" Height="28" />
                    </Button>
                    <TextBlock Margin="30,0,0,0" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"><Run Text="TIJORAT" Foreground="White" /><Run Text="."/><Run Text="PRO" Foreground="#FF332B" /><Run Text=" | " Foreground="#FF332B"/><Run Text="Fast Food" Foreground="White" /></TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Width="700" Background="#111C2B" CornerRadius="10" Effect="{StaticResource SoftShadow}" VerticalAlignment="Top" Height="56" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="92">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Касса" Style="{StaticResource NavButtonStyle}" Background="White" Foreground="#FF2B22">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" Margin="0,0,14,0" />
                                <TextBlock Text="Касса" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Заказы" Style="{StaticResource NavButtonStyle}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardListOutline" Width="20" Height="20" Margin="0,0,14,0" />
                                <TextBlock Text="Заказы" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,22,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTime}" Foreground="White" FontSize="25" FontWeight="Black" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CurrentDate}" Foreground="White" FontSize="18" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button x:Name="ProfileButton" Grid.Column="1" Click="ProfileButton_OnClick" Style="{StaticResource ProfileButtonStyle}">
                        <Border Height="76" CornerRadius="12" BorderBrush="#152236" BorderThickness="1" Background="#07101B" Padding="22,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountOutline" Width="28" Height="28" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CashierName}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" />
                                    <Ellipse Width="8" Height="8" Fill="#23C55E" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                    <Popup x:Name="ProfilePopup"
                           PlacementTarget="{Binding ElementName=ProfileButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="260"
                                Margin="0,8,0,0"
                                Background="White"
                                BorderBrush="#DDE3EB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Настройки" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                <Button Command="{Binding LogoutCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Foreground="#FF2B22">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Выйти" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSidebarOpen, Converter={StaticResource SidebarWidthConverter}}" />
                <ColumnDefinition Width="*" MinWidth="860" />
                <ColumnDefinition Width="620" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E6EBF1" BorderThickness="0,0,1,0" Padding="20,22,20,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,2,16">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:CategoryButton Category="{Binding}"
                                                         IsSelected="{Binding IsSelected}"
                                                         SelectCommand="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    Height="74"
                    Margin="22,22,10,0"
                    VerticalAlignment="Top"
                    BorderThickness="2"
                    Background="Transparent">
                <Grid Margin="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="28" Height="28" Foreground="#344054" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="TopSearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="19"
                                         Foreground="#111827"
                                         Padding="0,18,12,0" />
                                <TextBlock Text="Поиск товара по названию или штрихкоду"
                                           Foreground="#667085"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TopSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Command="{Binding ToggleProductViewCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="64" Height="54">
                        <materialDesign:PackIcon Kind="{Binding ProductViewIcon}" Width="25" Height="25" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="22,100,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,0,26,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="28" Height="28" Foreground="#344054" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="19"
                                         Foreground="#111827"
                                         Padding="0,20,12,0" />
                                <TextBlock Text="Поиск товара по названию или штрихкоду"
                                           Foreground="#667085"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="{Binding ProductViewIcon}" Command="{Binding ToggleProductViewCommand}" Style="{StaticResource TinyIconButtonStyle}" Width="96" Height="68" FontSize="24" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,0"
                              Visibility="{Binding IsCardView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Width" Value="166" />
                                <Setter Property="Height" Value="148" />
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ProductCard Product="{Binding}"
                                                      AddCommand="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Background="White"
                        BorderBrush="#DEE4EC"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                            <Grid Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Фото" FontSize="15" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Товар" FontSize="15" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Остаток" FontSize="15" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Цена" FontSize="15" FontWeight="Medium" Foreground="#475467" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                FocusVisualStyle="{x:Null}"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder" Background="White" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="18,0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF7F6" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF0EF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Height="72">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding ImagePath}" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" Foreground="#111827" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="Арт: " FontSize="12" Foreground="#98A2B3" />
                                                        <TextBlock Text="{Binding Sku, TargetNullValue=-}" FontSize="12" Foreground="#667085" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                        <TextBlock Text="  ШК: " FontSize="12" Foreground="#98A2B3" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Barcode, TargetNullValue=-}" FontSize="12" Foreground="#667085" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat={}{0:0.##}}" FontSize="14" FontWeight="Medium" Foreground="#475467" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat={}{0:0} c}" FontSize="16" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" />
                                                <Border Grid.Column="4" Width="48" Height="40" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock FontSize="16" Foreground="#102033" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Text" Value="+" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedQuantity}" Value="True"><Setter Property="Text" Value="{Binding SelectedQuantity}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#CBD2DC" Margin="6,0" />
                    <Ellipse Width="10" Height="10" Fill="#FF2B22" Margin="6,0" />
                    <Ellipse Width="10" Height="10" Fill="#CBD2DC" Margin="6,0" />
                    <Ellipse Width="10" Height="10" Fill="#CBD2DC" Margin="6,0" />
                    <Ellipse Width="10" Height="10" Fill="#CBD2DC" Margin="6,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2" Margin="16,22,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="В зале" Command="{Binding SelectOrderTypeCommand}" CommandParameter="В зале" Background="#58C783" Margin="0,6,10,12" Style="{StaticResource OrderTypeButtonStyle}" />
                    <Button Grid.Column="1" Content="С собой" Command="{Binding SelectOrderTypeCommand}" CommandParameter="С собой" Background="#4B92E8" Margin="10,6,10,12" Style="{StaticResource OrderTypeButtonStyle}" />
                    <Button Grid.Column="2" Content="Доставка" Command="{Binding SelectOrderTypeCommand}" CommandParameter="Доставка" Background="#FF9A43" Margin="10,6,0,12" Style="{StaticResource OrderTypeButtonStyle}" />
                </Grid>

                <Border Grid.Row="1" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="82" />
                            <RowDefinition Height="34" />
                            <RowDefinition />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="20,0,20,0">
                            <Grid>
                                <TextBlock Text="{Binding CurrentOrder.DisplayName}" FontSize="20" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding AddNoteCommand}" Style="{StaticResource TinyIconButtonStyle}">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="24" Height="24" />
                                    </Button>
                                    <Button Command="{Binding ShowCustomerCommand}" Style="{StaticResource TinyIconButtonStyle}" Margin="14,0,0,0">
                                        <materialDesign:PackIcon Kind="AccountPlusOutline" Width="24" Height="24" />
                                    </Button>
                                    <Button Command="{Binding ShowReceiptCommand}" Style="{StaticResource TinyIconButtonStyle}" Margin="14,0,0,0">
                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="24" Height="24" />
                                    </Button>
                                    <Button x:Name="OrderActionsButton" Click="OrderActionsButton_OnClick" Style="{StaticResource TinyIconButtonStyle}" Margin="14,0,0,0">
                                        <materialDesign:PackIcon Kind="DotsVertical" Width="24" Height="24" />
                                    </Button>
                                    <Popup x:Name="OrderActionsPopup"
                                           PlacementTarget="{Binding ElementName=OrderActionsButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Width="230"
                                                Margin="0,8,0,0"
                                                Background="White"
                                                BorderBrush="#DDE3EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8"
                                                Effect="{StaticResource SoftShadow}">
                                            <StackPanel>
                                                <Button Command="{Binding AddNoteCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Примечание" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding HoldOrderCommand}" Style="{StaticResource ProfileMenuButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="PauseCircleOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Отложить чек" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Border Height="1" Background="#EEF2F6" Margin="8,6" />
                                                <Button Command="{Binding ClearOrderCommand}" Style="{StaticResource ProfileMenuButtonStyle}" Foreground="#FF2B22">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" Margin="0,0,12,0" />
                                                        <TextBlock Text="Очистить чек" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="20,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Фото" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Товар" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Кол-во" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Цена" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Сумма" FontSize="12" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,0,20,0" Margin="0,0,0,224" Grid.RowSpan="2">
                            <ItemsControl ItemsSource="{Binding CurrentOrder.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:OrderItemRow Item="{Binding}"
                                                               IncreaseCommand="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               DecreaseCommand="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               RemoveCommand="{Binding DataContext.RemoveOrderItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" VerticalAlignment="Top" Margin="20 0">
                            <Button Command="{Binding PayCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="78" Margin="0,0,0,0">
                                <Grid Width="520">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                                        <materialDesign:PackIcon Kind="CashRegister" Width="28" Height="28" Foreground="White" Margin="0,0,12,0" />
                                <TextBlock Text="Касса" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentOrder.Total, StringFormat={}{0:0} c}" FontSize="32" FontWeight="ExtraBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
                                </Grid>
                            </Button>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding HoldOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="52" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PauseCircleOutline" Width="22" Height="22" Margin="0,0,12,0" />
                                        <TextBlock Text="Отложить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding ClearOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="52" Foreground="#FF2B22" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="22" Height="22" Margin="0,0,12,0" />
                                        <TextBlock Text="Очистить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D9E2EC" BorderThickness="0,1,0,0" Effect="{StaticResource SoftShadow}">
            <Grid Margin="20,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Чеки" FontSize="20" FontWeight="Black" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="1" Height="44" Background="#E6EBF1" />
                    <Border Grid.Column="2" Width="44" Height="44" CornerRadius="22" Background="#F2F4F7">
                        <TextBlock Text="{Binding OpenOrders.Count}" Foreground="#111827" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OpenOrders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource OrderFooterButtonStyle}">
                                    <Grid Width="204">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="5" Background="#FB970E" VerticalAlignment="Center">
                                            <TextBlock Text="Ⅱ" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat={}{0:0} c}" FontSize="18" FontWeight="Bold" Foreground="#475467" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2" Command="{Binding CreateNewOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="260" Height="62" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="32" Foreground="#344054" Margin="0,-5,18,0" />
                        <TextBlock Text="Новый чек" FontSize="20" Foreground="#344054" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
