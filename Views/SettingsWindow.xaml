<Window x:Class="FFPOS.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Настройки"
        Width="900"
        Height="700"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI"
        Loaded="WindowLoaded">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#0B1220" />

        <Style x:Key="ScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#CBD5E1"
                                CornerRadius="5"
                                Margin="3,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Value="{TemplateBinding Value}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#F91F25" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E91920" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D9151B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#DDE3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrinterComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="White"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrinterComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="BorderBrush" Value="#DDE3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PrinterComboBoxItemStyle}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="RootBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter Margin="14,0,42,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                <materialDesign:PackIcon Kind="ChevronDown"
                                                                         Width="20"
                                                                         Height="20"
                                                                         Foreground="#667085"
                                                                         HorizontalAlignment="Right"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,12,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#B8C2D0" />
                                                <Setter TargetName="RootBorder" Property="Background" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#94A3B8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="White"
                                        BorderBrush="#DDE3EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240">
                                    <ScrollViewer Margin="0,6" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="White"
            BorderBrush="#DDE3EB"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="85" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E8EDF3"
                    BorderThickness="0,0,0,1"
                    Padding="28,0"
                    PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#FFF0EF">
                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" Foreground="#F91F25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Orientation="Vertical" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Настройки приложения" FontSize="21" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock x:Name="HeaderSubtitle" Text="Все параметры POS в одном месте" FontSize="13" Foreground="#667085" />
                        </StackPanel>
                    </StackPanel>
                    <controls:WindowControlButtons HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Основное" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <controls:SettingTextField x:Name="BaseUrlBox" Header="BaseUrl" IconKind="LinkVariant" />
                                    <controls:SettingTextField x:Name="PublicUrlBox" Grid.Column="2" Header="PublicUrl" IconKind="FolderUploadOutline" />
                                    <controls:SettingTextField x:Name="StoreNameBox" Grid.Row="2" Header="Организация" IconKind="StorefrontOutline" IsReadOnly="True" />
                                    <controls:SettingTextField x:Name="StorePhoneBox" Grid.Row="2" Grid.Column="2" Header="Зарегистрированный телефон" IconKind="PhoneOutline" IsReadOnly="True" />
                                    <controls:SettingTextField x:Name="AppDateBox" Grid.Row="4" Header="Дата активации" IconKind="CalendarCheckOutline" IsReadOnly="True" />
                                    <controls:SettingTextField x:Name="AppStatusTextBox" Grid.Row="4" Grid.Column="2" Header="Статус" IconKind="CheckCircleOutline" IsReadOnly="True" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Точка продаж" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown" />

                                <TextBlock Text="Выбор точки продаж" FontSize="13" FontWeight="SemiBold" Foreground="#667085" />
                                <ComboBox x:Name="StoreSelectBox"
                                          Margin="0,6,0,0"
                                          Style="{StaticResource PrinterComboBoxStyle}"
                                          SelectedValuePath="Id"
                                          TextSearch.TextPath="Name"
                                          SelectionChanged="StoreSelectBox_SelectionChanged"
                                          FocusVisualStyle="{x:Null}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border x:Name="StoreDetailsPanel"
                                        Margin="0,12,0,0"
                                        Background="#FBFCFE"
                                        BorderBrush="#E1E7EF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Реквизиты выбранной точки"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#667085"
                                                   Margin="0,0,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                            </Grid.RowDefinitions>

                                            <controls:SettingTextField x:Name="StoreNameInfoBox" Grid.Row="0" Header="Название точки" IconKind="StorefrontOutline" IsReadOnly="True" />
                                            <controls:SettingTextField x:Name="StoreAgelNameBox" Grid.Row="0" Grid.Column="2" Header="Юридическое название" IconKind="StorefrontOutline" IsReadOnly="True" />
                                            <controls:SettingTextField x:Name="StoreLocationBox" Grid.Row="2" Header="Адрес" IconKind="MapMarkerOutline" IsReadOnly="True" />
                                            <controls:SettingTextField x:Name="StorePhoneInfoBox" Grid.Row="2" Grid.Column="2" Header="Телефон" IconKind="PhoneOutline" IsReadOnly="True" />
                                            <controls:SettingTextField x:Name="StoreEmailBox" Grid.Row="4" Header="Email" IconKind="EmailOutline" IsReadOnly="True" />
                                            <controls:SettingTextField x:Name="StoreSiteBox" Grid.Row="4" Grid.Column="2" Header="Site" IconKind="Web" IsReadOnly="True" />
                                            <controls:SettingTextField x:Name="StoreDescriptionBox" Grid.Row="6" Grid.ColumnSpan="3" Header="Описание" IconKind="FileDocumentOutline" IsReadOnly="True" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="База данных" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown" />

                                <controls:SettingChoiceField x:Name="DatabaseTypeBox"
                                                             Header="Тип подключения БД"
                                                             LeftText="SQLite3"
                                                             RightText="MySQL"
                                                             Width="520" />

                                <StackPanel x:Name="SqliteDetailsPanel" Margin="0,12,0,0">
                                    <controls:SettingTextField x:Name="SQLitePathBox"
                                                               Header="Локальная база SQLite3"
                                                               IconKind="DatabaseOutline"
                                                               IsReadOnly="True" />
                                </StackPanel>

                                <Border x:Name="MySqlDetailsPanel"
                                        Margin="0,12,0,0"
                                        Background="#FBFCFE"
                                        BorderBrush="#E1E7EF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Параметры подключения MySQL"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#667085"
                                                   Margin="0,0,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <controls:SettingTextField x:Name="MySqlHostBox" Header="Хост" IconKind="Server" />
                                            <controls:SettingTextField x:Name="MySqlPortBox" Grid.Column="2" Header="Порт" IconKind="Dialpad" IsNumeric="True" />
                                            <controls:SettingTextField x:Name="MySqlDatabaseBox" Grid.Row="2" Header="База данных" IconKind="Database" />
                                            <controls:SettingTextField x:Name="MySqlUsernameBox" Grid.Row="2" Grid.Column="2" Header="Пользователь" IconKind="AccountOutline" />
                                            <controls:SettingTextField x:Name="MySqlPasswordBox" Grid.Row="4" Header="Пароль" IconKind="LockOutline" />

                                            <Grid Grid.Row="4" Grid.Column="2">
                                                <Button x:Name="TestMySqlButton"
                                                        Height="42"
                                                        VerticalAlignment="Bottom"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#DDE3EB"
                                                        BorderThickness="1"
                                                        Foreground="#344054"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}"
                                                        Click="TestMySqlClicked">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="ButtonBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="8">
                                                                <StackPanel Orientation="Horizontal"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="DatabaseCheckOutline"
                                                                                             Width="18"
                                                                                             Height="18"
                                                                                             Margin="0,0,8,0"
                                                                                             Foreground="#344054" />
                                                                    <TextBlock Text="Тест подключения"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{TemplateBinding Foreground}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2F7" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="POS" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown" />
                                <WrapPanel>
                                    <controls:SettingToggleField x:Name="IsTouchScreenBox" Header="Сенсорный экран" Margin="0,0,20,8" />
                                    <controls:SettingToggleField x:Name="TotalSummaBox" Header="Показывать итог" Margin="0,0,20,8" />
                                    <controls:SettingToggleField x:Name="ColumnQtyStockBox" Header="Показывать остаток" Margin="0,0,20,8" />
                                    <controls:SettingToggleField x:Name="NewRowBox" Header="Новая строка всегда" Margin="0,0,20,8" />
                                    <controls:SettingToggleField x:Name="EditPriceBox" Header="Изменение цены" Margin="0,0,20,8" />
                                    <controls:SettingToggleField x:Name="DiscountBox" Header="Доступ к скидке" Margin="0,0,20,8" />
                                </WrapPanel>
                                <controls:SettingTripleChoiceField x:Name="AppTypeBox"
                                                                   Header="Тип приложения"
                                                                   FirstText="Общий"
                                                                   SecondText="Аптека"
                                                                   ThirdText="Фаст Фуд"
                                                                   Width="520"
                                                                   Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Печать" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Принтер по умолчанию" FontSize="13" FontWeight="SemiBold" Foreground="#667085" />
                                        <ComboBox x:Name="PrinterNameDefaultBox"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource PrinterComboBoxStyle}"
                                                  FocusVisualStyle="{x:Null}" />
                                    </StackPanel>

                                    <controls:SettingToggleField x:Name="CheckPrintBox" Grid.Column="2" Header="Печать чеков по умолчанию" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="Фискальный модуль" FontSize="18" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown" />
                                    <Border Margin="12,0,0,0" Background="#F8FAFC" BorderBrush="#DDE3EB" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                        <TextBlock x:Name="FiscalStatusText" FontSize="13" FontWeight="SemiBold" Foreground="#667085" />
                                    </Border>
                                </StackPanel>

                                <controls:SettingToggleField x:Name="FiscalModuleToggle"
                                                             Header="Активируется синхронизацией"
                                                             IsEnabled="False"
                                                             Margin="0,0,0,12" />

                                <Border x:Name="FiscalDetailsPanel"
                                        Background="#FBFCFE"
                                        BorderBrush="#E1E7EF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Параметры фискального модуля"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#667085"
                                                   Margin="0,0,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <controls:SettingToggleField x:Name="MessagErrorBox" Header="Показывать ошибки" />
                                            <controls:SettingToggleField x:Name="FiscalPrintCheckBox" Grid.Column="2" Header="Печать фискальных чеков" />
                                            <controls:SettingTextField x:Name="PrinterIpBox" Grid.Row="2" Header="IP принтера" IconKind="IpNetworkOutline" />
                                            <controls:SettingTextField x:Name="PageWidthBox" Grid.Row="2" Grid.Column="2" Header="Ширина чека" IconKind="RulerSquare" IsNumeric="True" />
                                            <controls:SettingTextField x:Name="TaxTypeBox" Grid.Row="4" Header="Тип налога" IconKind="FilePercentOutline" />
                                            <controls:SettingTextField x:Name="VatCodeBox" Grid.Row="4" Grid.Column="2" Header="VAT code" IconKind="PercentOutline" />
                                        </Grid>

                                        <WrapPanel Margin="0,12,0,0">
                                            <controls:SettingTextField x:Name="CommodityBox" Header="Commodity" IconKind="PackageVariantClosed" Width="170" Margin="0,0,16,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Синхронизация и доступ" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <controls:SettingRangeField x:Name="SyncTimeInminBox" Header="Интервал синхронизации" IconKind="Sync" Minimum="5" Maximum="1440" Suffix="мин" />
                                    <controls:SettingRangeField x:Name="SyncDayBox" Grid.Column="2" Header="Синхронизация за дней" IconKind="CalendarRange" Minimum="0" Maximum="30" Suffix="дн" />
                                    <controls:SettingRangeField x:Name="MaxDiscountBox" Grid.Row="2" Header="Максимальная скидка" IconKind="SaleOutline" Minimum="0" Maximum="100" Suffix="%" />
                                    <controls:SettingChoiceField x:Name="FocusQtyBox" Grid.Row="2" Grid.Column="2" Header="Фокус в аптеке" LeftText="Количество" RightText="Упаковка" />
                                    <WrapPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                        <controls:SettingToggleField x:Name="ReturnSaleBox" Header="Возврат продаж" Margin="0,0,20,8" />
                                        <controls:SettingToggleField x:Name="PeopleShowBox" Header="Показывать клиента" Margin="0,0,20,8" />
                                        <controls:SettingToggleField x:Name="PeoplePayBox" Header="Принимать оплату" Margin="0,0,20,8" />
                                        <controls:SettingToggleField x:Name="DebtSaleBox" Header="Продажа в долг" Margin="0,0,20,8" />
                                        <controls:SettingToggleField x:Name="DeleteRowBox" Header="Удаление строки" Margin="0,0,20,8" />
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#E8EDF3" BorderThickness="1,0,0,0" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <controls:SettingTextField x:Name="AdminCodeBox"
                                               Width="400"
                                               Header="Код администратора"
                                               IconKind="ShieldKeyOutline"
                                               FloatingHeader="True"
                                               FieldHeight="52"
                                               VerticalAlignment="Center" />

                    <TextBlock x:Name="ErrorText"
                               Grid.Column="1"
                               Margin="18,0"
                               Foreground="#F91F25"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource FlatButtonStyle}" Width="140" Margin="0,0,10,0" Click="ReloadClicked">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Reload" Width="20" Height="20" Margin="0,0,10,0" />
                                <TextBlock Text="Сбросить" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SaveButtonStyle}" Width="190" Click="SaveClicked">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,10,0" />
                                <TextBlock Text="Сохранить" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
