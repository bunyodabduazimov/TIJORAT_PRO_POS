<Window x:Class="FFPOS.Views.OrderNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Примечание"
        Width="520"
        Height="310"
        MinWidth="480"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#0B1220" />

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#102033" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B33" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E1261F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="White"
            BorderBrush="#DEE4EC"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="20,0" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,140,0">
                        <materialDesign:PackIcon Kind="NoteEditOutline" Width="24" Height="24" Foreground="#111827" Margin="0,0,12,0" />
                        <TextBlock Text="Примечание к чеку" FontSize="21" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" />
                    </StackPanel>
                    <controls:WindowControlButtons HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,0">
                <TextBox x:Name="NoteBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="14"
                         FontSize="17"
                         Foreground="#111827"
                         Background="#F8FAFC"
                         BorderBrush="#D9E2EC"
                         BorderThickness="1"
                         CaretBrush="#FF2B22" />
            </Grid>

            <Grid Grid.Row="2" Margin="22,12,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" Style="{StaticResource DialogButtonStyle}" Margin="0,0,8,0" Click="CancelClicked" />
                <Button Grid.Column="1" Content="Сохранить" Style="{StaticResource PrimaryDialogButtonStyle}" Margin="8,0,0,0" Click="SaveClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
