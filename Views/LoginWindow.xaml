<Window x:Class="FFPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Авторизация"
        Width="1024"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI"
        KeyDown="WindowKeyDown"
        SizeChanged="WindowSizeChanged"
        Loaded="WindowLoaded">
    <Window.Resources>
        <DropShadowEffect x:Key="SoftWindowShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#0B1220" />

        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF0EF" />
                                <Setter Property="Foreground" Value="#FF2B22" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFE0DE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="BorderBrush" Value="#DDE3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="TextInputStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,14,0,0" />
        </Style>

        <Style x:Key="PasswordInputStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,14,0,0" />
        </Style>

        <Style x:Key="UserComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Height" Value="52" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Height" Value="44" />
                        <Setter Property="Padding" Value="14,0" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#111827" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EEF4FF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#DCEBFF" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#DCEBFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="ComboRoot">
                            <Border x:Name="ComboBorder"
                                    Background="White"
                                    BorderBrush="#DDE3EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"
                                                CornerRadius="5"
                                                Padding="14,0,12,0">
                                            <Grid>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,34,0" />
                                                <materialDesign:PackIcon Kind="ChevronDown" Width="21" Height="21" Foreground="#111827" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                </ToggleButton>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   PlacementTarget="{Binding ElementName=ComboBorder}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=ComboBorder}"
                                        MinWidth="{Binding ActualWidth, ElementName=ComboBorder}"
                                        Background="White"
                                        BorderBrush="#DDE3EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,6,0,0"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#080E18" />
            <Setter Property="BorderBrush" Value="#DDE3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="39" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="KeyBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="#F91F25" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E91920" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D9151B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="FooterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="FooterBorder" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FooterButtonStyle}">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{StaticResource SoftWindowShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="Transparent"
                        BorderBrush="#E8EDF3"
                        BorderThickness="0,0,0,1"
                        Padding="26,0"
                        PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#F4F7FB" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="LoginVariant"
                                                         Width="24"
                                                         Height="24"
                                                         Foreground="#24364A"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>
                            <Border Width="1" Height="40" Background="#DDE3EB" Margin="24,0,24,0" />
                            <TextBlock Text="Авторизация" FontSize="17" FontWeight="Medium" Foreground="#344054" VerticalAlignment="Center" />
                        </StackPanel>

                        <controls:WindowControlButtons HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid x:Name="ContentGrid" Grid.Row="1" Margin="30,20,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FormColumn" Width="450*" MinWidth="360" />
                        <ColumnDefinition x:Name="SpacerColumn" Width="50" MinWidth="22" />
                        <ColumnDefinition x:Name="KeypadColumn" Width="456*" MinWidth="330" />
                    </Grid.ColumnDefinitions>


                    <Grid x:Name="FormPanel" Grid.Column="0" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="15" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Image Source="pack://application:,,,/Assets/Images/logo.png"
                                   Width="250"
                                   Height="70"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,10">
                                <materialDesign:PackIcon Kind="AccountOutline" Width="23" Height="23" Foreground="#111827" VerticalAlignment="Center" />
                                <TextBlock Text="Логин:" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid>
                                <ComboBox x:Name="LoginBox"
                                            Style="{StaticResource UserComboStyle}"
                                            IsEditable="False"
                                            SelectionChanged="LoginSelectionChanged"
                                            PreviewGotKeyboardFocus="LoginBoxPreviewGotKeyboardFocus"
                                            DisplayMemberPath="DisplayName" />
                                <TextBlock x:Name="LoginPlaceholder"
                                            Text="Выберите пользователя"
                                            Foreground="#8A94A3"
                                            FontSize="17"
                                            FontWeight="Medium"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False" 
                                            Margin="15 0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,10">
                                <materialDesign:PackIcon Kind="LockOutline" Width="23" Height="23" Foreground="#111827" VerticalAlignment="Center" />
                                <TextBlock Text="Пинкод:" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource PasswordInputStyle}"
                                                 PasswordChanged="PasswordChanged" />
                                    <TextBox x:Name="VisiblePasswordBox"
                                             Grid.Column="0"
                                             Style="{StaticResource TextInputStyle}"
                                             Visibility="Collapsed"
                                             TextChanged="VisiblePasswordChanged" />
                                    <TextBlock x:Name="PasswordPlaceholder"
                                               Grid.Column="0"
                                               Text="Введите пинкод"
                                               Foreground="#8A94A3"
                                               FontSize="17"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <Button Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            Click="TogglePasswordClicked">
                                        <materialDesign:PackIcon x:Name="PasswordEyeIcon" Kind="EyeOffOutline" Width="25" Height="25" Foreground="#344054" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1" Background="#E5EAF0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="или" FontSize="17" FontWeight="Medium" Foreground="#667085" HorizontalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="#E5EAF0" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="QrcodeScan" Width="25" Height="25" Foreground="#344054" VerticalAlignment="Center" />
                            <TextBlock Text="Отсканируйте QR-код" FontSize="18" FontWeight="Medium" Foreground="#344054" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="10">
                            <TextBlock x:Name="AppNameText" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold" Foreground="#667085" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ErrorText" Foreground="#FF2B22" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,8" />
                            <Button Style="{StaticResource RedButtonStyle}" Click="LoginClicked">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LoginVariant" Width="31" Height="31" Margin="0,0,20,0" />
                                    <TextBlock Text="Войти" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Viewbox x:Name="KeypadPanel" Grid.Column="2" Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                        <UniformGrid Rows="4" Columns="3" Width="456" Height="456">
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="1" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="2" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="3" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="4" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="5" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="6" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="7" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="8" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="9" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Foreground="#F91F25" Content="C" Click="ClearPasswordClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Content="0" Click="NumberKeyClicked" />
                            <Button Style="{StaticResource KeyButtonStyle}" Margin="6" Foreground="#F91F25" Click="BackspaceClicked">
                                <materialDesign:PackIcon Kind="BackspaceOutline" Width="43" Height="43" />
                            </Button>
                        </UniformGrid>
                    </Viewbox>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" Padding="34,0">
                    <Grid>
                        <Button Style="{StaticResource FooterButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OpenKeyboardClicked">
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                <materialDesign:PackIcon Kind="KeyboardOutline" Width="25" Height="25" Margin="0,0,14,0" />
                                <TextBlock Text="Клавиатура" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource FooterIconButtonStyle}" Click="OpenSyncClicked">
                                <materialDesign:PackIcon Kind="Sync" Width="34" Height="34" />
                            </Button>
                            <Border Width="1" Height="38" Background="#DDE3EB" Margin="24,0" />
                            <Button Style="{StaticResource FooterIconButtonStyle}" Click="OpenSettingsClicked">
                                <materialDesign:PackIcon Kind="AccountCogOutline" Width="34" Height="34" />
                            </Button>
                            <Border Width="1" Height="38" Background="#DDE3EB" Margin="24,0" />
                            <Button Style="{StaticResource FooterIconButtonStyle}" Click="OpenSettingsClicked">
                                <materialDesign:PackIcon Kind="CogOutline" Width="38" Height="38" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

