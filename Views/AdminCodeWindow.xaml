<Window x:Class="FFPOS.Views.AdminCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Код администратора"
        Width="460"
        Height="570"
        MinWidth="420"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI"
        KeyDown="WindowKeyDown">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#0B1220" />

        <Style x:Key="CodeInputStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="56" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,13,0,0" />
        </Style>

        <Style x:Key="KeyButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#DDE3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E91920" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D9151B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="White"
            BorderBrush="#DDE3EB"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E8EDF3"
                    BorderThickness="0,0,0,1"
                    Padding="28,0"
                    PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,92,0">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#FFF0EF">
                            <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="24" Height="24" Foreground="#FF2B22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Код администратора" FontSize="21" FontWeight="Bold" Foreground="#111827" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <controls:WindowControlButtons ShowMaximize="False" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,20,30,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Введите код для открытия настроек"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#344054" />

                <Border Grid.Row="2"
                        Height="58"
                        Background="#FBFCFE"
                        BorderBrush="#DDE3EB"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="LockOutline"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="#344054"
                                                 VerticalAlignment="Center" />

                        <PasswordBox x:Name="CodeBox"
                                     Grid.Column="1"
                                     Style="{StaticResource CodeInputStyle}"
                                     PasswordChanged="CodeChanged" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Grid.Row="4"
                           Foreground="#FF2B22"
                           FontSize="13"
                           FontWeight="SemiBold"
                           MinHeight="18" />

                <UniformGrid Grid.Row="5" Rows="4" Columns="3" Height="228">
                    <Button Content="1" Tag="1" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="2" Tag="2" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="3" Tag="3" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="4" Tag="4" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="5" Tag="5" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="6" Tag="6" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="7" Tag="7" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="8" Tag="8" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="9" Tag="9" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Content="C" Margin="4" Foreground="#FF2B22" Style="{StaticResource KeyButtonStyle}" Click="ClearClicked" />
                    <Button Content="0" Tag="0" Margin="4" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                    <Button Margin="4" Foreground="#FF2B22" Style="{StaticResource KeyButtonStyle}" Click="BackspaceClicked">
                        <materialDesign:PackIcon Kind="BackspaceOutline" Width="28" Height="28" />
                    </Button>
                </UniformGrid>

                <Button Grid.Row="6"
                        Style="{StaticResource RedButtonStyle}"
                        Click="ConfirmClicked" Height="58" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CogOutline" Width="25" Height="25" Margin="0,0,12,0" />
                        <TextBlock Text="Открыть настройки" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
