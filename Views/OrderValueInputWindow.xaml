<Window x:Class="FFPOS.Views.OrderValueInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ввод значения"
        Width="400"
        Height="500"
        MinWidth="400"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="DialogShadow" BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#0B1220" />

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#102033" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                    <Setter Property="BorderBrush" Value="#FFB8B3" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFEDEA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeypadButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Height" Value="54" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B33" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E1261F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="16"
            Background="White"
            BorderBrush="#DEE4EC"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="18,0" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="Ввод значения"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#111827"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CancelClicked"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#FF2B22" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,14,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBox x:Name="ValueBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#111827"
                             FontSize="22"
                             FontWeight="SemiBold"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             TextAlignment="Right"
                             Padding="14,0"
                             TextChanged="ValueBoxTextChanged" />
                </Border>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource KeypadButtonStyle}" Content="1" Tag="1" Click="KeypadClicked" Margin="0,0,8,8" />
                    <Button Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Content="2" Tag="2" Click="KeypadClicked" Margin="0,0,8,8" />
                    <Button Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Content="3" Tag="3" Click="KeypadClicked" Margin="0,0,0,8" />

                    <Button Grid.Row="1" Style="{StaticResource KeypadButtonStyle}" Content="4" Tag="4" Click="KeypadClicked" Margin="0,0,8,8" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Content="5" Tag="5" Click="KeypadClicked" Margin="0,0,8,8" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Content="6" Tag="6" Click="KeypadClicked" Margin="0,0,0,8" />

                    <Button Grid.Row="2" Style="{StaticResource KeypadButtonStyle}" Content="7" Tag="7" Click="KeypadClicked" Margin="0,0,8,8" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Content="8" Tag="8" Click="KeypadClicked" Margin="0,0,8,8" />
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Content="9" Tag="9" Click="KeypadClicked" Margin="0,0,0,8" />

                    <Button x:Name="DotButton" Grid.Row="3" Style="{StaticResource KeypadButtonStyle}" Content="." Tag="." Click="KeypadClicked" Margin="0,0,8,0" />
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Content="0" Tag="0" Click="KeypadClicked" Margin="0,0,8,0" />
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Click="BackspaceClicked" Margin="0,0,0,0">
                        <materialDesign:PackIcon Kind="BackspaceOutline" Width="22" Height="22" Foreground="#FF2B22" />
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="18,8,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="CancelClicked" />
                <Button Grid.Column="1" Content="OK" Style="{StaticResource PrimaryDialogButtonStyle}" Margin="8,0,0,0" Click="OkClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
