<Window x:Class="FFPOS.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Оплата"
        Width="980"
        Height="640"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Inter, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#0B1220" />

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#102033" />
            <Setter Property="BorderBrush" Value="#DDE5EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                    <Setter Property="BorderBrush" Value="#FFB8B3" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFEDEA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B33" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E1261F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="White"
            BorderBrush="#DDE5EE"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="82" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="18,0" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashRegister" Width="22" Height="22" Foreground="#111827" Margin="0,0,10,0" />
                        <TextBlock Text="Оплата" FontSize="20" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" />
                    </StackPanel>
                    <controls:WindowControlButtons HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="430" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Итого:" FontSize="18" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#DDE5EE" BorderThickness="1" CornerRadius="8" Padding="14,0">
                            <TextBlock x:Name="TotalText" FontSize="24" FontWeight="ExtraBold" Foreground="#111827" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Row="1" Text="Тип оплаты:" FontSize="18" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" />
                        <UniformGrid Grid.Row="1" Grid.Column="1" Columns="3">
                            <Button x:Name="CashButton" Content="Наличные" Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="PaymentTypeClicked" />
                            <Button x:Name="CardButton" Content="Карта" Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="PaymentTypeClicked" />
                            <Button x:Name="MixedButton" Content="Смешанная" Style="{StaticResource BaseButtonStyle}" Click="PaymentTypeClicked" />
                        </UniformGrid>

                        <TextBlock Grid.Row="2" Text="К оплате:" FontSize="18" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" />
                        <Border Grid.Row="2" Grid.Column="1" Background="#FFF7F6" BorderBrush="#FFB8B3" BorderThickness="1" CornerRadius="8" Padding="14,0">
                            <TextBlock x:Name="PayableText" FontSize="24" FontWeight="ExtraBold" Foreground="#FF2B22" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Row="3" Text="Примечание:" FontSize="18" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" />
                        <Border Grid.Row="3" Grid.Column="1" Background="#F8FAFC" BorderBrush="#DDE5EE" BorderThickness="1" CornerRadius="8" Padding="14,0">
                            <TextBlock Text="-" FontSize="16" Foreground="#98A2B3" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,14,0,0" Background="#F8FAFC" BorderBrush="#DDE5EE" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="64" />
                                <RowDefinition Height="64" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Платежи" FontSize="16" FontWeight="Bold" Foreground="#344054" Margin="0,0,0,8" />

                            <Button x:Name="CashAmountButton" Grid.Row="1" Padding="0" Style="{StaticResource BaseButtonStyle}" Height="54" Click="CashAmountClicked">
                                <Border x:Name="CashAmountPanel" Background="Transparent" CornerRadius="8" Padding="14,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Cash" Width="24" Height="24" Foreground="#2EBD62" Margin="0,0,10,0" />
                                            <TextBlock Text="Наличные" FontSize="17" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="CashAmountText" Grid.Column="1" Text="0 c" FontSize="22" FontWeight="ExtraBold" Foreground="#111827" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Button>

                            <Button x:Name="CardAmountButton" Grid.Row="2" Padding="0" Style="{StaticResource BaseButtonStyle}" Height="54" Click="CardAmountClicked">
                                <Border x:Name="CardAmountPanel" Background="Transparent" CornerRadius="8" Padding="14,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CreditCardOutline" Width="24" Height="24" Foreground="#2478E8" Margin="0,0,10,0" />
                                            <TextBlock Text="Карта" FontSize="17" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="CardAmountText" Grid.Column="1" Text="0 c" FontSize="22" FontWeight="ExtraBold" Foreground="#111827" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Button>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Сумма оплаты" FontSize="16" FontWeight="Bold" Foreground="#344054" />
                                    <TextBlock x:Name="ReceivedText" Text="0 c" FontSize="24" FontWeight="ExtraBold" Foreground="#111827" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock x:Name="RemainderLabel" Text="Остаток" FontSize="16" FontWeight="Bold" Foreground="#344054" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="RemainderText" Text="0 c" FontSize="24" FontWeight="ExtraBold" Foreground="#FF2B22" HorizontalAlignment="Right" />
                                    <TextBlock Text="Сдача" FontSize="14" Foreground="#667085" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    <TextBlock x:Name="ChangeText" Text="0 c" FontSize="18" FontWeight="Bold" Foreground="#23A455" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Margin="22,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="KeyboardTitle" Text="Введите сумму" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="6,0,0,8" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button Content="1" Tag="1" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="2" Tag="2" Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="3" Tag="3" Grid.Row="0" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="4" Tag="4" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="5" Tag="5" Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="6" Tag="6" Grid.Row="1" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="7" Tag="7" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="8" Tag="8" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="9" Tag="9" Grid.Row="2" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="." Tag="." Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="0" Tag="0" Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="BackspaceClicked">
                            <materialDesign:PackIcon Kind="BackspaceOutline" Width="34" Height="34" Foreground="#FF2B22" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="6,8,6,0">
                        <TextBlock Text="Быстрые суммы" FontSize="15" FontWeight="Bold" Foreground="#475467" Margin="0,0,0,6" />
                        <UniformGrid Columns="4">
                            <Button x:Name="QuickAmount1Button" Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="QuickAmountClicked" />
                            <Button x:Name="QuickAmount2Button" Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="QuickAmountClicked" />
                            <Button x:Name="QuickAmount3Button" Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Click="QuickAmountClicked" />
                            <Button Content="Точно" Style="{StaticResource BaseButtonStyle}" Click="ExactAmountClicked" />
                        </UniformGrid>
                        <Button Content="C" Style="{StaticResource BaseButtonStyle}" Height="42" Margin="0,8,0,0" Foreground="#FF2B22" Click="ClearClicked" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="20,10,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BaseButtonStyle}" Height="56" Margin="0,0,8,0" Click="HoldClicked">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PauseCircleOutline" Width="22" Height="22" Margin="0,0,10,0" />
                        <TextBlock Text="Отложить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ConfirmButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="ConfirmClicked">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24" Margin="0,0,10,0" />
                        <TextBlock x:Name="ConfirmButtonText" Text="Оплатить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
