<Window x:Class="FFPOS.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Оплата"
        Width="720"
        Height="760"
        MinWidth="660"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="#F7F8FA"
        FontFamily="Inter, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="30" ShadowDepth="4" Opacity="0.16" Color="#0B1220" />

        <Style x:Key="PaymentButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#102033" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7F6" />
                    <Setter Property="BorderBrush" Value="#FFB8B3" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFEDEA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RedButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PaymentButtonStyle}">
            <Setter Property="Height" Value="70" />
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3B33" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E1261F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PaymentButtonStyle}">
            <Setter Property="Height" Value="70" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="White"
            BorderBrush="#DEE4EC"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
                <RowDefinition Height="98" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="28,0" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Оплата" FontSize="24" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" Margin="0,0,140,0" />
                    <controls:WindowControlButtons HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,22,28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Background="#F7F8FA" CornerRadius="10" Padding="18,14" BorderBrush="#E8EDF3" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="К оплате" FontSize="18" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalText" FontSize="34" FontWeight="ExtraBold" Foreground="#FF2B22" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Button x:Name="CashButton" Content="Наличные" Style="{StaticResource PaymentButtonStyle}" Click="PaymentTypeClicked" />
                        <Button x:Name="CardButton" Grid.Row="1" Content="Карта" Style="{StaticResource PaymentButtonStyle}" Margin="0,10,0,0" Click="PaymentTypeClicked" />
                        <Button x:Name="MixedButton" Grid.Row="2" Content="Смешанная" Style="{StaticResource PaymentButtonStyle}" Margin="0,10,0,0" Click="PaymentTypeClicked" />
                    </Grid>

                    <Button x:Name="CashAmountButton" Margin="0,18,0,0" Padding="0" Style="{StaticResource PaymentButtonStyle}" Height="82" Click="CashAmountClicked">
                        <Border x:Name="CashAmountPanel" Background="Transparent" CornerRadius="8" Padding="18,0">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Наличные" FontSize="16" FontWeight="SemiBold" Foreground="#667085" />
                                    <TextBlock x:Name="CashAmountText" Text="0 c" FontSize="28" FontWeight="ExtraBold" Foreground="#111827" />
                                </StackPanel>
                                <materialDesign:PackIcon Kind="Cash" Width="30" Height="30" Foreground="#2EBD62" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button x:Name="CardAmountButton" Margin="0,12,0,0" Padding="0" Style="{StaticResource PaymentButtonStyle}" Height="82" Click="CardAmountClicked">
                        <Border x:Name="CardAmountPanel" Background="Transparent" CornerRadius="8" Padding="18,0">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Карта" FontSize="16" FontWeight="SemiBold" Foreground="#667085" />
                                    <TextBlock x:Name="CardAmountText" Text="0 c" FontSize="28" FontWeight="ExtraBold" Foreground="#111827" />
                                </StackPanel>
                                <materialDesign:PackIcon Kind="CreditCardOutline" Width="30" Height="30" Foreground="#2478E8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Button>

                    <Border Margin="0,18,0,0" Background="#07101B" CornerRadius="10" Padding="18,13">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="RemainderLabel" Text="Осталось" Foreground="#C9D3DF" FontSize="16" />
                                <TextBlock x:Name="RemainderText" Text="0 c" Foreground="White" FontSize="30" FontWeight="ExtraBold" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="Сдача" Foreground="#C9D3DF" FontSize="16" HorizontalAlignment="Right" />
                                <TextBlock x:Name="ChangeText" Text="0 c" Foreground="#2EBD62" FontSize="30" FontWeight="ExtraBold" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                    <TextBlock x:Name="KeyboardTitle" Text="Введите сумму" FontSize="19" FontWeight="Bold" Foreground="#111827" Margin="6,0,0,10" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button Content="1" Tag="1" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="2" Tag="2" Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="3" Tag="3" Grid.Row="0" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="4" Tag="4" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="5" Tag="5" Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="6" Tag="6" Grid.Row="1" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="7" Tag="7" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="8" Tag="8" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="9" Tag="9" Grid.Row="2" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Content="C" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyButtonStyle}" Click="ClearClicked" />
                        <Button Content="0" Tag="0" Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyButtonStyle}" Click="NumberClicked" />
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeyButtonStyle}" Click="BackspaceClicked">
                            <materialDesign:PackIcon Kind="BackspaceOutline" Width="28" Height="28" />
                        </Button>
                    </Grid>
                    <Button Content="Точно" Style="{StaticResource PaymentButtonStyle}" Height="58" Margin="6,12,6,0" Click="ExactAmountClicked" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="28,10,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" Style="{StaticResource PaymentButtonStyle}" Margin="0,0,8,0" Click="CancelClicked" />
                <Button x:Name="ConfirmButton" Grid.Column="1" Content="Оплатить" Style="{StaticResource RedButtonStyle}" Margin="8,0,0,0" Click="ConfirmClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
