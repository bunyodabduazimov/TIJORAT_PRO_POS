<Window x:Class="FFPOS.Views.DiscountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Скидка"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F7F8FA"
        FontFamily="Inter, Segoe UI">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" MouseLeftButtonDown="HeaderMouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Скидка" FontSize="24" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" Margin="0,0,140,0" />
                <controls:WindowControlButtons HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Процент скидки" FontSize="14" FontWeight="Medium" Foreground="#475467" />
            <Border Height="50" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,8,0,18">
                <TextBox x:Name="PercentBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Padding="14,12,14,0"
                         Text="0" />
            </Border>

            <TextBlock Text="Сумма скидки" FontSize="14" FontWeight="Medium" Foreground="#475467" />
            <Border Height="50" Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                <TextBox x:Name="AmountBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Padding="14,12,14,0"
                         Text="0" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Style="{StaticResource DialogButtonStyle}" Margin="0,0,8,0" Click="Cancel_OnClick" />
            <Button Grid.Column="1" Content="Применить" Style="{StaticResource DialogButtonStyle}" Background="#FF2B22" Foreground="White" BorderThickness="0" Margin="8,0,0,0" Click="Apply_OnClick" />
        </Grid>
    </Grid>
</Window>
