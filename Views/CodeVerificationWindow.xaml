<Window x:Class="FFPOS.Views.CodeVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:FFPOS.Controls"
        Title="Код подтверждения"
        Width="500"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Inter, Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#0B1220" />
        <Style x:Key="CodeBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="BorderBrush" Value="#DDE3EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="MaxLength" Value="1" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="#FF2B22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#FF2B22" />
                                <Setter TargetName="InputBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RedButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="#FF2B22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="10" Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="10,0" PreviewMouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,92,0">
                        <Border Width="35" Height="35" CornerRadius="21" Background="#FFF0EF">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="24" Height="24" Foreground="#FF2B22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Код подтверждения" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <controls:WindowControlButtons ShowMaximize="False" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="32,28,32,30">
                <TextBlock x:Name="SentText" FontSize="16" FontWeight="SemiBold" Foreground="#344054" TextWrapping="NoWrap" />
                <TextBlock x:Name="ExpiresText" FontSize="14" FontWeight="SemiBold" Foreground="#667085" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBox x:Name="Code1" Style="{StaticResource CodeBoxStyle}" TextChanged="CodeTextChanged" PreviewTextInput="CodePreviewTextInput" PreviewKeyDown="CodePreviewKeyDown" />
                    <TextBox x:Name="Code2" Style="{StaticResource CodeBoxStyle}" Margin="12,0,0,0" TextChanged="CodeTextChanged" PreviewTextInput="CodePreviewTextInput" PreviewKeyDown="CodePreviewKeyDown" />
                    <TextBox x:Name="Code3" Style="{StaticResource CodeBoxStyle}" Margin="12,0,0,0" TextChanged="CodeTextChanged" PreviewTextInput="CodePreviewTextInput" PreviewKeyDown="CodePreviewKeyDown" />
                    <TextBox x:Name="Code4" Style="{StaticResource CodeBoxStyle}" Margin="12,0,0,0" TextChanged="CodeTextChanged" PreviewTextInput="CodePreviewTextInput" PreviewKeyDown="CodePreviewKeyDown" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#FF2B22" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" TextWrapping="Wrap" />
                <Button x:Name="VerifyButton" Content="Подтвердить" Style="{StaticResource RedButtonStyle}" Margin="0,50,0,0" Click="VerifyClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
