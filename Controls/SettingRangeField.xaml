<UserControl x:Class="FFPOS.Controls.SettingRangeField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FontFamily="Inter, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="{Binding Header, ElementName=Root}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#667085"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="{Binding IconKind, ElementName=Root}"
                                         Width="16"
                                         Height="16"
                                         Foreground="#F91F25"
                                         Margin="0,0,6,0" />
                <TextBlock x:Name="ValueText"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#111827" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="#FBFCFE"
                BorderBrush="#DDE3EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,0">
            <Grid x:Name="TrackHost"
                  Height="28"
                  VerticalAlignment="Center"
                  MouseLeftButtonDown="TrackMouseLeftButtonDown"
                  MouseMove="TrackMouseMove"
                  MouseLeftButtonUp="TrackMouseLeftButtonUp"
                  SizeChanged="TrackHostSizeChanged">
                <Border Height="8"
                        Background="#E8EEF6"
                        CornerRadius="4"
                        VerticalAlignment="Center" />

                <Border x:Name="FillBar"
                        Height="8"
                        Background="#F91F25"
                        CornerRadius="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />

                <Border x:Name="Thumb"
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        BorderBrush="#F91F25"
                        BorderThickness="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
