<UserControl x:Class="FFPOS.Controls.ProductCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="166"
             Height="148"
             FontFamily="Inter, Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TransparentCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="156" />
            <Setter Property="Height" Value="138" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,11,10,10" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF2B22" />
                    <Setter Property="Background" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Button Command="{Binding AddCommand, ElementName=Root}"
            CommandParameter="{Binding Product, ElementName=Root}"
            Style="{StaticResource TransparentCardButtonStyle}"
            Width="166"
            Height="148"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid ClipToBounds="True">
                <Ellipse Width="104"
                         Height="18"
                         Fill="#33000000"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,82,0,0"
                         Panel.ZIndex="0">
                    <Ellipse.Effect>
                        <BlurEffect Radius="9" />
                    </Ellipse.Effect>
                </Ellipse>

                <Image x:Name="ProductImage"
                       Source="{Binding Product.ImagePath, ElementName=Root}"
                       Stretch="Uniform"
                       Width="132"
                       Height="90"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"
                       Panel.ZIndex="1"
                       ImageFailed="ProductImage_OnImageFailed" />

                <TextBlock Text="{Binding Product.Name, ElementName=Root}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#101828"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Top"
                           Panel.ZIndex="2" />

                <TextBlock Text="{Binding Product.Price, ElementName=Root, StringFormat={}{0:0} c}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#030712"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Panel.ZIndex="2" />

                <TextBlock Text="+"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#C5CCD6"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,2,-2"
                           Panel.ZIndex="2" />

                <Border MinWidth="25"
                        Height="24"
                        CornerRadius="9"
                        Background="#FF2B22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="8,0"
                        Margin="0,-1,-1,0"
                        Panel.ZIndex="3"
                        Visibility="{Binding Product.HasSelectedQuantity, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Product.SelectedQuantity, ElementName=Root}"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-1,0,0" />
                </Border>
            </Grid>
        </Border>
    </Button>
</UserControl>
