<UserControl x:Class="FFPOS.Controls.CategoryButton"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="50"
             FontFamily="Inter, Segoe UI"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="TransparentCategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Height" Value="50" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFB3AF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF2B22" />
                    <Setter Property="Background" Value="#FFFFFE" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                    <Setter Property="Foreground" Value="#FF2B22" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Button Command="{Binding SelectCommand, ElementName=Root}"
            CommandParameter="{Binding Category, ElementName=Root}"
            Style="{StaticResource TransparentCategoryButtonStyle}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
        <Border Style="{StaticResource CategoryCardStyle}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="ViewGrid"
                                         Width="20"
                                         Height="20"
                                         Foreground="#FF2B22"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category.Id, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <Image Width="21"
                       Height="21"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       Source="{Binding Category.IconPath, ElementName=Root, FallbackValue=/Assets/Images/default.png, TargetNullValue=/Assets/Images/default.png}">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category.Id, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock Grid.Column="1"
                           Text="{Binding Category.Name, ElementName=Root}"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CategoryTextStyle}" />
            </Grid>
        </Border>
    </Button>
</UserControl>
