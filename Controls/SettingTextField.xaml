<UserControl x:Class="FFPOS.Controls.SettingTextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FontFamily="Inter, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="FieldRow" Height="42" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Text="{Binding Header, ElementName=Root}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#667085" />

        <Border x:Name="FieldBorder"
                Grid.Row="2"
                Background="#FBFCFE"
                BorderBrush="#DDE3EB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon x:Name="IconHost"
                                         Kind="{Binding IconKind, ElementName=Root}"
                                         Width="18"
                                         Height="18"
                                         Foreground="#9AA3AF"
                                         VerticalAlignment="Center"
                                         Margin="12,0,0,0" />

                <TextBox x:Name="InputBox"
                         Grid.Column="1"
                         Style="{StaticResource FieldTextBoxStyle}"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="InputBoxPreviewTextInput"
                         IsReadOnly="{Binding IsReadOnly, ElementName=Root}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                x:Name="FloatingHeaderText"
                Background="White"
                Padding="5,0"
                Margin="14,-1,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <TextBlock Text="{Binding Header, ElementName=Root}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#667085" />
        </Border>
    </Grid>
</UserControl>
