<UserControl x:Class="FFPOS.Controls.OrderItemRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinHeight="72"
             FontFamily="Inter, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="QtyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#B9C4D2" />
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="78" />
            </Grid.ColumnDefinitions>

            <Image Source="{Binding Item.Product.ImagePath, ElementName=Root}"
                   Width="64"
                   Height="54"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Item.Product.Name, ElementName=Root}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#111827"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Item.Description, ElementName=Root}"
                           FontSize="13"
                           Foreground="#475467"
                           Margin="0,1,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <materialDesign:PackIcon Kind="PencilOutline"
                                             Width="14"
                                             Height="14"
                                             Foreground="#2563EB"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Item.Note, ElementName=Root, TargetNullValue=''}"
                               FontSize="13"
                               Foreground="#475467"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Item.HasNote, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Button Content="-"
                        Command="{Binding DecreaseCommand, ElementName=Root}"
                        CommandParameter="{Binding Item, ElementName=Root}"
                        Style="{StaticResource QtyButtonStyle}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Item.Quantity, ElementName=Root}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="+"
                        Command="{Binding IncreaseCommand, ElementName=Root}"
                        CommandParameter="{Binding Item, ElementName=Root}"
                        Style="{StaticResource QtyButtonStyle}" />
            </Grid>

            <TextBlock Grid.Column="3"
                       Text="{Binding Item.Total, ElementName=Root, StringFormat={}{0:0} c}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#030712"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />

        </Grid>
    </Border>
</UserControl>
