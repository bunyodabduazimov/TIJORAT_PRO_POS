<UserControl x:Class="FFPOS.Controls.OrderItemRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinHeight="54"
             FontFamily="Inter, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="QtyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#B9C4D2" />
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RowBorder"
            Background="White"
            BorderBrush="#E8EDF3"
            BorderThickness="0,0,0,1"
            Padding="0,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="98" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="62" />
            </Grid.ColumnDefinitions>

            <Image Source="{Binding Item.Product.ImagePath, ElementName=Root}"
                   Width="44"
                   Height="36"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Item.Product.Name, ElementName=Root}"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="#111827"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Button Content="-"
                        Command="{Binding DecreaseCommand, ElementName=Root}"
                        CommandParameter="{Binding Item, ElementName=Root}"
                        Style="{StaticResource QtyButtonStyle}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Item.Quantity, ElementName=Root}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="+"
                        Command="{Binding IncreaseCommand, ElementName=Root}"
                        CommandParameter="{Binding Item, ElementName=Root}"
                        Style="{StaticResource QtyButtonStyle}" />
            </Grid>

            <TextBlock Grid.Column="3"
                       Text="{Binding Item.Price, ElementName=Root, StringFormat={}{0:0} c}"
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="#111827"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="4"
                       Text="{Binding Item.Total, ElementName=Root, StringFormat={}{0:0} c}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#030712"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />

        </Grid>
    </Border>
</UserControl>
